{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "VRCX-0-Nanashi",
    "version": "3.0.0",
    "identifier": "dev.namelessnanashi.vrcx-0-nanashi",
    "build": {
        "frontendDist": "../dist",
        "devUrl": "http://localhost:9000",
        "beforeDevCommand": "npm run dev",
        "beforeBuildCommand": "npm run build"
    },
    "app": {
        "withGlobalTauri": false,
        "security": {
            "csp": {
                "img-src": [
                    "'self'",
                    "https:",
                    "http://localhost:*",
                    "http://vrcx-0-img.localhost",
                    "http://vrcx-0-thumb.localhost",
                    "http://vrcx-0-bg-img.localhost",
                    "asset:",
                    "vrcx-0-img:",
                    "vrcx-0-thumb:",
                    "vrcx-0-bg-img:",
                    "data:",
                    "blob:"
                ],
                "worker-src": ["'self'", "blob:"]
            }
        },
        "windows": [
            {
                "label": "main",
                "create": false,
                "title": "VRCX-0-Nanashi",
                "width": 1024,
                "height": 768,
                "minWidth": 320,
                "minHeight": 240,
                "center": true,
                "decorations": false,
                "resizable": true
            }
        ],
        "trayIcon": {
            "id": "main",
            "iconPath": "icons/icon.png",
            "tooltip": "VRCX-0-Nanashi"
        }
    },
    "bundle": {
        "active": true,
        "licenseFile": "DISCLAIMER.txt",
        "resources": {
            "../LICENSE": "LICENSE",
            "../LICENSES/MIT.txt": "LICENSES/MIT.txt",
            "../LICENSES/OFL-1.1-0xProto.txt": "LICENSES/OFL-1.1-0xProto.txt",
            "resources/licenses/THIRD_PARTY_NOTICES.txt": "licenses/THIRD_PARTY_NOTICES.txt"
        },
        "targets": ["nsis"],
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "windows": {
            "digestAlgorithm": "sha256",
            "timestampUrl": "http://time.certum.pl",
            "nsis": {
                "installerIcon": "icons/icon.ico",
                "displayLanguageSelector": false,
                "installMode": "currentUser",
                "installerHooks": "installer/ytdlp-hooks.nsh"
            }
        },
        "createUpdaterArtifacts": true
    },
    "plugins": {
        "deep-link": {
            "desktop": {
                "schemes": ["vrcx-0-nanashi", "vrcx-0", "vrcx"]
            }
        },
        "updater": {
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc2RkU0RTAyMjA2NTBDQ0MKUldUTURHVWdBazcrZGpZaXpiTE9xYTJ1aGpQNURYMHBqOG5WRnhhVHdQSmdWU2EyMHc2ckRPNXIK",
            "endpoints": [
                "https://github.com/NanashiTheNameless/VRCX-0-Nanashi/releases/latest/download/version_manifest.json"
            ],
            "windows": {
                "installMode": "passive"
            }
        }
    }
}
