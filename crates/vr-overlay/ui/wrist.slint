export struct WristDeviceItem {
    label: string,
    percent: string,
    label-color: color,
    percent-color: color,
    battery-color: color,
    battery-fill: float,
    show-percent: bool,
    show-battery: bool,
}

export struct WristFeedItem {
    time: string,
    actor: string,
    detail: string,
    actor-color: color,
    detail-color: color,
    accent-color: color,
    has-actor: bool,
    show-accent: bool,
}

export struct WristPlayerItem {
    name: string,
    joined: string,
    status: string,
    note: string,
    name-color: color,
    has-status: bool,
    has-note: bool,
}

component WristPlayerColumn inherits VerticalLayout {
    in property <[WristPlayerItem]> cells;
    in property <float> scale: 1;
    in property <color> quiet-color;
    in property <color> muted-color;
    in property <color> note-color;
    alignment: start;
    spacing: 7px * root.scale;

    for cell in root.cells : VerticalLayout {
        // An explicit width lets wrapped text report its real height when the
        // column is measured.
        width: root.width;
        spacing: 1px;

        HorizontalLayout {
            spacing: 6px * root.scale;

            Text {
                horizontal-stretch: 1;
                width: root.width - joined.preferred-width - 6px * root.scale;
                text: cell.name;
                font-size: 14px * root.scale;
                font-weight: 600;
                wrap: word-wrap;
                color: cell.name-color;
            }

            joined := Text {
                horizontal-stretch: 0;
                text: cell.joined;
                font-size: 12px * root.scale;
                vertical-alignment: center;
                color: root.quiet-color;
            }
        }

        if cell.has-status : Text {
            width: root.width;
            text: cell.status;
            font-size: 12px * root.scale;
            wrap: word-wrap;
            color: root.muted-color;
        }

        if cell.has-note : Text {
            width: root.width;
            text: cell.note;
            font-size: 12px * root.scale;
            wrap: word-wrap;
            color: root.note-color;
        }
    }
}

export component WristPanel inherits Window {
    default-font-family: "0xProto";
    background: transparent;

    in property <bool> dark-background: true;
    in property <[WristDeviceItem]> devices: [];
    in property <[WristFeedItem]> feed-lines: [];
    // Fork: newest feed row last; rows that do not fit are skipped from the top.
    in property <bool> feed-newest-at-bottom: false;
    // Fork: Players / Notes grid, up to six columns.
    in property <int> player-column-count: 0;
    in property <[WristPlayerItem]> players-0: [];
    in property <[WristPlayerItem]> players-1: [];
    in property <[WristPlayerItem]> players-2: [];
    in property <[WristPlayerItem]> players-3: [];
    in property <[WristPlayerItem]> players-4: [];
    in property <[WristPlayerItem]> players-5: [];
    in property <string> footer-left;
    in property <string> footer-center;
    in property <string> footer-right;
    in property <string> now-playing-title;
    in property <string> now-playing-time;
    in property <bool> now-playing-has-progress: false;
    in property <float> now-playing-progress: 0;
    // Fork: text size per area (Settings > VR), the grid's fit factor from the
    // host, and the tallest the panel may be.
    in property <float> header-scale: 1;
    in property <float> footer-scale: 1;
    in property <float> content-scale: 1;
    in property <float> grid-fit-scale: 1;
    in property <length> max-panel-height: 1024px;

    property <float> grid-scale: root.content-scale * root.grid-fit-scale;
    property <color> background-color: root.dark-background ? #0d1117f2 : #0d1117b8;
    property <color> edge-color: #ffffff24;
    property <color> divider-color: #ffffff1f;
    property <color> muted-color: root.dark-background ? #aeb6c2 : #d5dbe4;
    property <color> quiet-color: root.dark-background ? #7f8996 : #c3cad4;
    property <color> now-playing-title-color: root.dark-background ? #d5dbe4 : #e6ebf1;
    property <color> now-playing-accent-color: #38bdf8;
    property <length> header-height: 44px * root.header-scale;
    property <length> footer-height: 34px * root.footer-scale;
    property <length> row-height: 38px * root.content-scale;
    property <length> feed-top: root.header-height + 5px * root.content-scale;
    property <length> now-playing-padding: 8px * root.content-scale;
    property <length> now-playing-meter-height: 14px * root.content-scale;
    property <bool> now-playing-title-truncated: now-playing-title-measure.preferred-height > now-playing-title.preferred-height;
    property <length> now-playing-height: root.now-playing-title != ""
        ? root.now-playing-padding * 2 + now-playing-title.preferred-height + 6px * root.content-scale + root.now-playing-meter-height
        : 0px;
    property <bool> has-player-grid: root.player-column-count > 0;
    property <length> player-grid-spacing: 12px * root.grid-scale;
    property <length> player-column-width: root.has-player-grid
        ? (root.width - 28px - (root.player-column-count - 1) * root.player-grid-spacing) / root.player-column-count
        : 0px;
    // Fork: height the panel needs; the host resizes the window to it. The feed
    // stops at whole rows within max-panel-height. The Players / Notes grid
    // lists every player; the host adds columns, then shrinks the grid text,
    // until it fits. Each column is measured on its own because a horizontal
    // layout ignores wrapped text when reporting height.
    out property <length> required-height: root.has-player-grid
        ? root.feed-top
            + max(players-column-0.preferred-height, players-column-1.preferred-height, players-column-2.preferred-height, players-column-3.preferred-height, players-column-4.preferred-height, players-column-5.preferred-height)
            + 10px * root.grid-scale + root.now-playing-height + root.footer-height
        : (root.feed-row-limit > 0
            ? root.feed-top + root.feed-row-limit * root.row-height
            : root.header-height) + root.now-playing-height + root.footer-height;
    property <int> feed-row-limit: Math.max(0, Math.min(
        root.feed-lines.length,
        Math.floor((root.max-panel-height - root.feed-top - root.now-playing-height - root.footer-height) / root.row-height)));
    property <float> visible-rows: Math.min(
        root.feed-lines.length,
        Math.floor((root.height - root.feed-top - root.now-playing-height - root.footer-height) / root.row-height));
    property <float> feed-skip: root.feed-newest-at-bottom ? Math.max(0, root.feed-lines.length - root.visible-rows) : 0;

    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: root.has-player-grid
            ? root.height
            : (root.visible-rows > 0
                ? root.feed-top + root.visible-rows * root.row-height
                : root.header-height) + root.now-playing-height + root.footer-height;
        border-radius: 18px;
        border-width: 1px;
        border-color: root.edge-color;
        clip: true;
        background: root.background-color;

        Rectangle {
            x: 0px;
            y: root.header-height;
            width: parent.width;
            height: 1px;
            background: root.divider-color;
        }

        Rectangle {
            x: 0px;
            y: parent.height - root.footer-height;
            width: parent.width;
            height: 1px;
            background: root.divider-color;
        }

        Rectangle {
            x: 18px;
            y: 10px * root.header-scale;
            width: parent.width - 36px;
            height: 24px * root.header-scale;
            clip: true;

            HorizontalLayout {
                x: 0px;
                y: 0px;
                height: 24px * root.header-scale;
                spacing: 10px * root.header-scale;
                alignment: start;

                for device in root.devices : HorizontalLayout {
                    spacing: 4px * root.header-scale;

                    Text {
                        text: device.label;
                        font-size: 14px * root.header-scale;
                        font-weight: 600;
                        vertical-alignment: center;
                        color: device.label-color;
                    }

                    if device.show-percent: Text {
                        text: device.percent;
                        font-size: 12px * root.header-scale;
                        vertical-alignment: center;
                        color: device.percent-color;
                    }

                    if device.show-battery: Rectangle {
                        width: 23px * root.header-scale;

                        Rectangle {
                            x: 0px;
                            y: 7px * root.header-scale;
                            width: 18px * root.header-scale;
                            height: 10px * root.header-scale;
                            border-color: device.battery-color;
                            border-width: 2px;
                            border-radius: 2px;
                            background: transparent;

                            Rectangle {
                                x: 3px * root.header-scale;
                                y: 3px * root.header-scale;
                                width: 12px * root.header-scale * device.battery-fill;
                                height: 4px * root.header-scale;
                                border-radius: 1px;
                                background: device.battery-color;
                            }
                        }

                        Rectangle {
                            x: 18px * root.header-scale;
                            y: 10px * root.header-scale;
                            width: 3px * root.header-scale;
                            height: 4px * root.header-scale;
                            border-radius: 1px;
                            background: device.battery-color;
                        }
                    }
                }
            }
        }

        players-column-0 := WristPlayerColumn {
            x: 14px + 0 * (root.player-column-width + root.player-grid-spacing);
            y: root.feed-top;
            width: root.player-column-width;
            height: self.preferred-height;
            visible: root.has-player-grid;
            cells: root.players-0;
            scale: root.grid-scale;
            quiet-color: root.quiet-color;
            muted-color: root.muted-color;
            note-color: root.now-playing-title-color;
        }

        players-column-1 := WristPlayerColumn {
            x: 14px + 1 * (root.player-column-width + root.player-grid-spacing);
            y: root.feed-top;
            width: root.player-column-width;
            height: self.preferred-height;
            visible: root.has-player-grid;
            cells: root.players-1;
            scale: root.grid-scale;
            quiet-color: root.quiet-color;
            muted-color: root.muted-color;
            note-color: root.now-playing-title-color;
        }

        players-column-2 := WristPlayerColumn {
            x: 14px + 2 * (root.player-column-width + root.player-grid-spacing);
            y: root.feed-top;
            width: root.player-column-width;
            height: self.preferred-height;
            visible: root.has-player-grid;
            cells: root.players-2;
            scale: root.grid-scale;
            quiet-color: root.quiet-color;
            muted-color: root.muted-color;
            note-color: root.now-playing-title-color;
        }

        players-column-3 := WristPlayerColumn {
            x: 14px + 3 * (root.player-column-width + root.player-grid-spacing);
            y: root.feed-top;
            width: root.player-column-width;
            height: self.preferred-height;
            visible: root.has-player-grid;
            cells: root.players-3;
            scale: root.grid-scale;
            quiet-color: root.quiet-color;
            muted-color: root.muted-color;
            note-color: root.now-playing-title-color;
        }

        players-column-4 := WristPlayerColumn {
            x: 14px + 4 * (root.player-column-width + root.player-grid-spacing);
            y: root.feed-top;
            width: root.player-column-width;
            height: self.preferred-height;
            visible: root.has-player-grid;
            cells: root.players-4;
            scale: root.grid-scale;
            quiet-color: root.quiet-color;
            muted-color: root.muted-color;
            note-color: root.now-playing-title-color;
        }

        players-column-5 := WristPlayerColumn {
            x: 14px + 5 * (root.player-column-width + root.player-grid-spacing);
            y: root.feed-top;
            width: root.player-column-width;
            height: self.preferred-height;
            visible: root.has-player-grid;
            cells: root.players-5;
            scale: root.grid-scale;
            quiet-color: root.quiet-color;
            muted-color: root.muted-color;
            note-color: root.now-playing-title-color;
        }

        for line[index] in root.feed-lines : Rectangle {
            x: 14px;
            y: root.feed-top + (index - root.feed-skip) * root.row-height;
            width: parent.width - 28px;
            height: root.row-height;
            visible: index >= root.feed-skip && index < root.feed-skip + root.visible-rows;

            if line.show-accent : Rectangle {
                x: 0px;
                y: 8px * root.content-scale;
                width: 3px;
                height: 22px * root.content-scale;
                border-radius: 2px;
                background: line.accent-color;
            }

            Text {
                x: 11px;
                y: 0px;
                width: 42px * root.content-scale;
                height: root.row-height - 1px;
                text: line.time;
                font-size: 13px * root.content-scale;
                vertical-alignment: center;
                color: root.quiet-color;
            }

            HorizontalLayout {
                x: 11px + 51px * root.content-scale;
                y: 0px;
                width: parent.width - self.x;
                height: root.row-height - 1px;
                spacing: 5px * root.content-scale;

                if line.has-actor: Text {
                    horizontal-stretch: 0;
                    text: line.actor;
                    font-size: 16px * root.content-scale;
                    font-weight: 600;
                    vertical-alignment: center;
                    color: line.actor-color;
                }

                Text {
                    horizontal-stretch: 1;
                    text: line.detail;
                    font-size: 16px * root.content-scale;
                    vertical-alignment: center;
                    overflow: elide;
                    color: line.detail-color;
                }
            }
        }

        Rectangle {
            x: 0px;
            y: parent.height - root.footer-height - root.now-playing-height;
            width: parent.width;
            height: root.now-playing-height;
            visible: root.now-playing-title != "";
            clip: true;

            Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: 1px;
                background: root.divider-color;
            }

            now-playing-title-measure := Text {
                width: now-playing-title.width;
                height: 0px;
                visible: false;
                text: root.now-playing-title;
                font-size: 14px * root.content-scale;
                wrap: word-wrap;
            }

            now-playing-title := Text {
                x: 18px;
                y: root.now-playing-padding;
                width: parent.width - 36px - now-playing-ellipsis.width;
                height: self.preferred-height;
                max-lines: 2;
                text: root.now-playing-title;
                font-size: 14px * root.content-scale;
                wrap: word-wrap;
                overflow: clip;
                vertical-alignment: top;
                color: root.now-playing-title-color;
            }

            now-playing-ellipsis := Text {
                x: parent.width - 18px - self.width;
                y: root.now-playing-padding + now-playing-title.preferred-height / 2;
                width: self.preferred-width + 4px;
                height: now-playing-title.preferred-height / 2;
                visible: root.now-playing-title-truncated;
                text: "...";
                font-size: 14px * root.content-scale;
                horizontal-alignment: right;
                vertical-alignment: top;
                color: root.now-playing-title-color;
            }

            HorizontalLayout {
                x: 18px;
                y: root.now-playing-padding + now-playing-title.preferred-height + 6px * root.content-scale;
                width: parent.width - 36px;
                height: root.now-playing-meter-height;
                spacing: 10px * root.content-scale;

                Rectangle {
                    horizontal-stretch: 1;

                    if root.now-playing-has-progress : Rectangle {
                        x: 0px;
                        y: (parent.height - 3px) / 2;
                        width: parent.width;
                        height: 3px;
                        border-radius: 2px;
                        background: root.divider-color;
                        clip: true;

                        Rectangle {
                            x: 0px;
                            y: 0px;
                            width: parent.width * root.now-playing-progress;
                            height: parent.height;
                            background: root.now-playing-accent-color;
                        }
                    }
                }

                Text {
                    horizontal-stretch: 0;
                    text: root.now-playing-time;
                    font-size: 12px * root.content-scale;
                    vertical-alignment: center;
                    color: root.quiet-color;
                }
            }
        }

        Text {
            x: 18px;
            y: parent.height - root.footer-height + 10px * root.footer-scale;
            width: self.preferred-width;
            height: 17px * root.footer-scale;
            text: root.footer-left;
            font-size: 12px * root.footer-scale;
            color: root.muted-color;
        }

        Text {
            x: (parent.width - self.width) / 2;
            y: parent.height - root.footer-height + 10px * root.footer-scale;
            width: self.preferred-width;
            height: 17px * root.footer-scale;
            text: root.footer-center;
            font-size: 12px * root.footer-scale;
            horizontal-alignment: center;
            color: root.muted-color;
        }

        Text {
            x: parent.width - 18px - self.width;
            y: parent.height - root.footer-height + 10px * root.footer-scale;
            width: self.preferred-width;
            height: 17px * root.footer-scale;
            text: root.footer-right;
            font-size: 12px * root.footer-scale;
            horizontal-alignment: right;
            color: root.muted-color;
        }
    }
}
