export struct OverlayBadgeItem {
    icon: string,
    from: color,
    to: color,
    border: color,
    icon-color: color,
    glow-color: color,
    round: bool,
    animations: bool,
    shimmer: bool,
    flow: bool,
    sparkle: bool,
    glow: bool,
    embers: bool,
    wiggle: bool,
    flip: bool,
    glitch: bool,
    upstream-glint: bool,
    flip-before-wiggle: bool,
}

export global BadgeRasterizer {
    pure callback frame(OverlayBadgeItem, float) -> image;
}

export component BadgeChip inherits Rectangle {
    in property <OverlayBadgeItem> badge;
    in property <length> size: 16px;
    property <bool> moving: root.badge.animations && (root.badge.shimmer || root.badge.flow
        || root.badge.sparkle || root.badge.glow || root.badge.embers || root.badge.wiggle
        || root.badge.flip || root.badge.glitch || root.badge.upstream-glint);
    width: root.size;
    height: root.size;

    Image {
        x: -root.size * 0.6;
        y: -root.size * 0.6;
        width: root.size * 2.2;
        height: root.size * 2.2;
        source: BadgeRasterizer.frame(root.badge, root.moving ? animation-tick() / 1ms : -1);
        image-fit: fill;
        image-rendering: smooth;
    }
}

export component BadgeRow inherits HorizontalLayout {
    in property <[OverlayBadgeItem]> badges;
    in property <length> size: 16px;
    spacing: root.size / 5;
    alignment: start;

    for badge in root.badges : BadgeChip {
        badge: badge;
        size: root.size;
    }
}
